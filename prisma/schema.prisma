generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id          Int        @id @default(autoincrement())
  nome        String     @db.VarChar(80)
  turma       String     @db.VarChar(20)
  responsavel String     @db.VarChar(80)
  email       String     @db.VarChar(100)
  obs         String?    @db.VarChar(255)
  saldo       Decimal    @default(0) @db.Decimal(9, 2)
  depositos   Deposito[]
  vendas      Venda[]

  @@map("alunos")
}

model Produto {
  id     Int     @id @default(autoincrement())
  nome   String  @db.VarChar(60)
  quant  Int
  preco  Decimal @db.Decimal(9, 2)
  vendas Venda[]
  deleted  Boolean  @default(false)
  deletedAt DateTime?

  @@map("produtos")
}

model Deposito {
  id      Int          @id @default(autoincrement())
  alunoId Int
  aluno   Aluno        @relation(fields: [alunoId], references: [id])
  usuarioId Int?
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id])
  valor   Decimal      @db.Decimal(10, 2)
  tipo    TipoDeposito
  data    DateTime     @default(now())

  @@map("depositos")
}

model Venda {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aluno     Aluno    @relation(fields: [alunoId], references: [id])
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id])
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  quant     Int
  preco     Decimal  @db.Decimal(10, 2)
  data      DateTime @default(now())

  @@map("vendas")
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nome                 String    @db.VarChar(80)
  email                String    @db.VarChar(100) @unique
  senha                String    @db.VarChar(255)
  nivel                Role      @default(OPERADOR)
  ultimoLogin          DateTime?
  recoveryCode         String?   @db.VarChar(255)
  recoveryExpiresAt    DateTime?
  createdAt            DateTime  @default(now())

  depositos            Deposito[]
  vendas               Venda[]
  logs                 Log[]

  @@map("usuarios")
}

model Log {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  acao      String   @db.VarChar(255)
  descricao String?  @db.VarChar(255)
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@map("logs")
}

enum Role {
  ADMIN
  GERENTE
  OPERADOR
}

enum TipoDeposito {
  PIX
  Cartao
  Dinheiro
}
